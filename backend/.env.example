# Copy this file to .env and fill in your own values.
# Never commit .env or paste secrets into frontend code.

PORT=4000
NODE_ENV=development
APP_BASE_URL=http://localhost:4000
API_BASE_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:4000

# Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=REPLACE_WITH_SUPABASE_PROJECT_URL
SUPABASE_ANON_KEY=REPLACE_WITH_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/integrations/google/callback
GOOGLE_SCOPES=https://www.googleapis.com/auth/gmail.modify,https://www.googleapis.com/auth/calendar.events

# Optional integrations (not active until implemented/configured)
META_APP_ID=
META_APP_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
PAYMENT_PROVIDER=
PAYMENT_API_BASE_URL=
PAYMENT_API_KEY=
WEBHOOK_SIGNING_SECRET=
INTEGRATION_TOKEN_ENCRYPTION_KEY=
